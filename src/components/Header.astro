---
import { Image } from "astro:assets";
import salman from "../../public/salman-ahmed.jpg";

const navItems = [
  { href: "#hero", label: "Portfolio", active: true },
  { href: "#process", label: "Process" },
  { href: "#stories", label: "Client Stories" },
  { href: "#contact", label: "Contact" },
];
---

<header class="absolute inset-x-0 top-0 z-30 w-full px-4 pt-4 sm:px-6 lg:px-8 lg:pt-6">
  <div
    class="fixed left-1/2 -translate-x-1/2  flex w-full max-w-7xl items-center justify-between gap-4 rounded-full border border-white/10 bg-black/50 px-4 py-3 text-white shadow-[0_20px_80px_rgba(0,0,0,0.35)] backdrop-blur-xl"
  >
    <a href="#hero" class="flex items-center gap-3" aria-label="Salman Ahmed home">
      <Image
        src={salman}
        alt="Salman Ahmed"
        width={40}
        height={40}
        class="size-10 rounded-full object-cover ring-1 ring-white/15"
      />
      <div class="flex flex-col leading-none">
        <span class="text-base font-semibold tracking-[0.2em] text-white/70 uppercase">
          Salman
        </span>
        <span class="text-lg font-semibold tracking-tight text-white">
          Ahmed
        </span>
      </div>
    </a>

    <nav
      aria-label="Primary navigation"
      class="hidden items-center gap-8 text-sm font-medium uppercase tracking-[0.18em] text-white/70 md:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "relative pb-2 transition-colors duration-200 hover:text-white",
              item.active && "text-white",
            ]}
          >
            {item.label}
            {
              item.active && (
                <span class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-primary to-secondary" />
              )
            }
          </a>
        ))
      }
    </nav>

    <a
      href="https://www.linkedin.com/in/salman-ahmed-designer/"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-primary to-secondary px-5 py-2 text-sm font-semibold text-white shadow-[0_10px_30px_rgba(116,93,255,0.45)] transition-transform duration-200 hover:-translate-y-0.5"
    >
      Hire Me
    </a>
  </div>

  <nav
    aria-label="Mobile navigation"
    class="mx-auto mt-3 flex w-full max-w-7xl items-center gap-2 overflow-x-auto px-1 pb-1 text-xs font-semibold uppercase tracking-[0.16em] text-white/70 md:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "whitespace-nowrap rounded-full border border-white/10 bg-white/5 px-4 py-2 transition-colors duration-200 hover:bg-white/10 hover:text-white",
            item.active && "border-primary/50 bg-primary/15 text-white",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

---
import { Image } from "astro:assets";
import salman from "../../public/salman-ahmed.jpg";

const navItems = [
  { href: "#hero", label: "Portfolio", active: true },
  { href: "#process", label: "Process" },
  { href: "#stories", label: "Client Stories" },
  { href: "#contact", label: "Contact" },
];
---

<header class="absolute inset-x-0 top-0 z-30 w-full px-4 pt-4 sm:px-6 lg:px-8 lg:pt-6">
  <div
    class="site-nav-shadow fixed left-1/2 flex w-full max-w-7xl -translate-x-1/2 items-center justify-between gap-4 rounded-full border border-white/10 bg-black/50 px-4 py-3 text-white backdrop-blur-xl"
  >
    <a href="#hero" class="flex items-center gap-3" aria-label="Salman Ahmed home">
      <Image
        src={salman}
        alt="Salman Ahmed"
        width={40}
        height={40}
        class="size-10 rounded-full object-cover ring-1 ring-white/15"
      />
      <div class="flex flex-col leading-none">
        <span class="text-base font-semibold tracking-[0.2em] text-white/70 uppercase">
          Salman
        </span>
        <span class="text-lg font-semibold tracking-tight text-white">
          Ahmed
        </span>
      </div>
    </a>

    <nav
      aria-label="Primary navigation"
      class="hidden items-center gap-8 text-sm font-medium uppercase tracking-[0.18em] text-white/70 md:flex"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-header-nav-link
            class:list={[
              "relative pb-2 transition-colors duration-200 hover:text-white",
              item.active && "text-white",
            ]}
          >
            {item.label}
            <span
              class:list={[
                "absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-primary to-secondary transition-opacity duration-200",
                item.active ? "opacity-100" : "opacity-0",
              ]}
              data-header-nav-line
            />
          </a>
        ))
      }
    </nav>

    <a
      href="https://www.linkedin.com/in/salman-ahmed-designer/"
      target="_blank"
      rel="noopener noreferrer"
      class="site-compact-cta-shadow inline-flex shrink-0 items-center justify-center rounded-full bg-gradient-to-r from-primary to-secondary px-5 py-2 text-sm font-semibold text-white transition-transform duration-200 hover:-translate-y-0.5"
    >
      Hire Me
    </a>
  </div>

  <nav
    aria-label="Mobile navigation"
    class="mx-auto mt-3 flex w-full max-w-7xl items-center gap-2 overflow-x-auto px-1 pb-1 text-xs font-semibold uppercase tracking-[0.16em] text-white/70 md:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          data-header-mobile-link
          class:list={[
            "whitespace-nowrap rounded-full border border-white/10 bg-white/5 px-4 py-2 transition-colors duration-200 hover:bg-white/10 hover:text-white",
            item.active && "border-primary/50 bg-primary/15 text-white",
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script is:inline>
  const desktopNavLinks = document.querySelectorAll("[data-header-nav-link]");
  const mobileNavLinks = document.querySelectorAll("[data-header-mobile-link]");
  const headerNavLinks = [...desktopNavLinks, ...mobileNavLinks];

  const setHeaderActive = (href) => {
    desktopNavLinks.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;

      const isActive = link.getAttribute("href") === href;
      const line = link.querySelector("[data-header-nav-line]");
      link.classList.toggle("text-white", isActive);
      line?.classList.toggle("opacity-100", isActive);
      line?.classList.toggle("opacity-0", !isActive);
    });

    mobileNavLinks.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;

      const isActive = link.getAttribute("href") === href;
      link.classList.toggle("border-primary/50", isActive);
      link.classList.toggle("bg-primary/15", isActive);
      link.classList.toggle("text-white", isActive);
    });
  };

  headerNavLinks.forEach((link) => {
    if (!(link instanceof HTMLAnchorElement)) return;

    link.addEventListener("click", () => {
      const href = link.getAttribute("href");
      if (href?.startsWith("#")) {
        setHeaderActive(href);
      }
    });
  });

  const observedSections = [...new Set(headerNavLinks.map((link) => link.getAttribute("href")))]
    .filter((href) => href?.startsWith("#"))
    .map((href) => document.querySelector(href))
    .filter(Boolean);

  if (observedSections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visibleEntry?.target?.id) {
          setHeaderActive(`#${visibleEntry.target.id}`);
        }
      },
      {
        threshold: [0.2, 0.45, 0.7],
        rootMargin: "-30% 0px -55% 0px",
      }
    );

    observedSections.forEach((section) => observer.observe(section));
  }
</script>

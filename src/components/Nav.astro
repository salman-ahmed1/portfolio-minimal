---
import { Image } from "astro:assets";
import salman from "../../public/salman-ahmed.jpg";

interface Props {
  currentPage?: "portfolio" | "web-development";
}

const { currentPage = "portfolio" } = Astro.props;
const isWebDevelopmentPage = currentPage === "web-development";

const navItems = isWebDevelopmentPage
  ? [
      { href: "#web-hero", label: "Web Development", active: true },
      { href: "#services", label: "Services" },
      { href: "#web-projects", label: "Web Work" },
      { href: "#contact", label: "Contact" },
    ]
  : [
      { href: "#hero", label: "Portfolio", active: true },
      { href: "#process", label: "Process" },
      { href: "#stories", label: "Client Stories" },
      { href: "/web-development", label: "Web Development" },
      { href: "#contact", label: "Contact" },
    ];

const homeHref = isWebDevelopmentPage ? "/" : "#hero";
const hireHref = isWebDevelopmentPage
  ? "#contact"
  : "https://www.linkedin.com/in/salman-ahmed-designer/";
---

<header class="absolute inset-x-0 top-0 z-30 w-full px-4 pt-4 sm:px-6 lg:px-8 lg:pt-6">
  <div
    class="theme-nav-muted bg-white/50 dark:bg-slate-500/60 site-nav-shadow fixed left-1/2 flex w-[calc(100%_-_2rem)] max-w-7xl -translate-x-1/2 items-center justify-between gap-2 rounded-full border px-3 py-2.5 backdrop-blur-xl sm:w-[calc(100%_-_3rem)] sm:gap-4 sm:px-4 sm:py-3 lg:w-[calc(100%_-_4rem)] 2xl:max-w-screen-2xl 2xl:px-6"
  >
    <a href={homeHref} class="flex items-center gap-3" aria-label="Salman Ahmed home">
      <Image
        src={salman}
        alt="Salman Ahmed"
        width={40}
        height={40}
        class="size-9 rounded-full object-cover ring-1 ring-border sm:size-10"
      />
      <div class="flex flex-col leading-none">
        <span class="theme-nav-muted text-sm font-semibold tracking-[0.2em] uppercase sm:text-base">
          Salman
        </span>
        <span class="theme-strong text-base font-semibold tracking-tight sm:text-lg">
          Ahmed
        </span>
      </div>
    </a>

    <nav
      aria-label="Primary navigation"
      class="theme-nav-muted hidden items-center gap-5 text-xs font-medium uppercase tracking-[0.14em] xl:flex xl:gap-7 xl:text-sm xl:tracking-[0.16em]"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-header-nav-link
            aria-current={item.active ? "page" : undefined}
            class:list={[
              "relative pb-2 transition-colors duration-200",
              item.active && "theme-strong",
            ]}
          >
            {item.label}
            <span
              class:list={[
                "absolute inset-x-0 bottom-0 h-px bg-primary transition-opacity duration-200",
                item.active ? "opacity-100" : "opacity-0",
              ]}
              data-header-nav-line
            />
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        class="theme-control inline-flex size-9 items-center justify-center rounded-full border outline-none transition-transform duration-200 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:size-10"
        aria-label="Switch to dark theme"
        aria-pressed="false"
        title="Switch to dark theme"
        data-theme-toggle
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.5 4.5l1.4 1.4M18.1 18.1l1.4 1.4M2.5 12h2M19.5 12h2M4.5 19.5l1.4-1.4M18.1 5.9l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
        </svg>
      </button>

      <a
        href={hireHref}
        target={isWebDevelopmentPage ? undefined : "_blank"}
        rel={isWebDevelopmentPage ? undefined : "noopener noreferrer"}
        class="theme-primary-cta site-compact-cta-shadow hidden shrink-0 items-center justify-center rounded-full px-5 py-2 text-sm font-semibold transition-transform duration-200 hover:-translate-y-0.5 xl:inline-flex"
      >
        Hire Me
      </a>

      <button
        type="button"
        class="theme-control inline-flex size-9 items-center justify-center rounded-full border outline-none transition-transform duration-200 hover:-translate-y-0.5 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:size-10 xl:hidden"
        aria-label="Open navigation menu"
        aria-controls="mobile-navigation"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-mobile-menu-open-icon>
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <svg class="hidden size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-mobile-menu-close-icon>
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav
      id="mobile-navigation"
      aria-label="Mobile navigation"
      class="theme-nav site-nav-shadow absolute inset-x-0 top-full mt-3 hidden rounded-3xl border p-2 backdrop-blur-xl xl:hidden"
      data-mobile-menu
    >
      <div class="flex flex-col gap-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-header-mobile-link
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "theme-control flex items-center justify-between rounded-2xl border px-4 py-3 text-sm font-semibold transition-colors duration-200",
                item.active && "border-primary/50 bg-primary/15 theme-strong",
              ]}
            >
              {item.label}
              <span aria-hidden="true">&#8599;</span>
            </a>
          ))
        }
      </div>
      <a
        href={hireHref}
        target={isWebDevelopmentPage ? undefined : "_blank"}
        rel={isWebDevelopmentPage ? undefined : "noopener noreferrer"}
        class="theme-primary-cta site-compact-cta-shadow mt-2 flex min-h-12 items-center justify-center rounded-2xl px-4 py-3 text-sm font-semibold"
        data-mobile-menu-hire
      >
        Hire Me
      </a>
    </nav>
  </div>
</header>

<script is:inline>
  const themeToggles = document.querySelectorAll("[data-theme-toggle]");

  const syncThemeToggles = () => {
    const isDark = document.documentElement.classList.contains("dark");
    themeToggles.forEach((toggle) => {
      if (!(toggle instanceof HTMLButtonElement)) return;
      const label = isDark ? "Switch to light theme" : "Switch to dark theme";
      toggle.setAttribute("aria-label", label);
      toggle.setAttribute("title", label);
      toggle.setAttribute("aria-pressed", String(isDark));
    });
  };

  syncThemeToggles();

  themeToggles.forEach((toggle) => {
    toggle.addEventListener("click", () => {
      const isDark = !document.documentElement.classList.contains("dark");
      document.documentElement.classList.toggle("dark", isDark);
      try {
        localStorage.setItem("theme", isDark ? "dark" : "light");
      } catch {
        // The theme still works for this page when storage is unavailable.
      }
      syncThemeToggles();
    });
  });

  const desktopNavLinks = document.querySelectorAll("[data-header-nav-link]");
  const mobileNavLinks = document.querySelectorAll("[data-header-mobile-link]");
  const headerNavLinks = [...desktopNavLinks, ...mobileNavLinks];
  const mobileMenuToggle = document.querySelector("[data-mobile-menu-toggle]");
  const mobileMenu = document.querySelector("[data-mobile-menu]");
  const mobileMenuOpenIcon = document.querySelector("[data-mobile-menu-open-icon]");
  const mobileMenuCloseIcon = document.querySelector("[data-mobile-menu-close-icon]");

  const setMobileMenuOpen = (isOpen) => {
    if (!(mobileMenuToggle instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;

    mobileMenu.classList.toggle("hidden", !isOpen);
    mobileMenuToggle.setAttribute("aria-expanded", String(isOpen));
    mobileMenuToggle.setAttribute("aria-label", isOpen ? "Close navigation menu" : "Open navigation menu");
    mobileMenuOpenIcon?.classList.toggle("hidden", isOpen);
    mobileMenuCloseIcon?.classList.toggle("hidden", !isOpen);
  };

  if (mobileMenuToggle instanceof HTMLButtonElement) {
    mobileMenuToggle.addEventListener("click", () => {
      setMobileMenuOpen(mobileMenuToggle.getAttribute("aria-expanded") !== "true");
    });
  }

  const setHeaderActive = (href) => {
    desktopNavLinks.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;

      const isActive = link.getAttribute("href") === href;
      const line = link.querySelector("[data-header-nav-line]");
      link.classList.toggle("theme-strong", isActive);
      line?.classList.toggle("opacity-100", isActive);
      line?.classList.toggle("opacity-0", !isActive);
    });

    mobileNavLinks.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;

      const isActive = link.getAttribute("href") === href;
      link.classList.toggle("border-primary/50", isActive);
      link.classList.toggle("bg-primary/15", isActive);
      link.classList.toggle("theme-strong", isActive);
    });
  };

  headerNavLinks.forEach((link) => {
    if (!(link instanceof HTMLAnchorElement)) return;

    link.addEventListener("click", () => {
      const href = link.getAttribute("href");
      if (href?.startsWith("#")) {
        setHeaderActive(href);
      }
      setMobileMenuOpen(false);
    });
  });

  document.querySelector("[data-mobile-menu-hire]")?.addEventListener("click", () => setMobileMenuOpen(false));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMobileMenuOpen(false);
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Node) || !(mobileMenu instanceof HTMLElement) || !(mobileMenuToggle instanceof HTMLElement)) return;
    if (!mobileMenu.contains(event.target) && !mobileMenuToggle.contains(event.target)) {
      setMobileMenuOpen(false);
    }
  });

  const observedSections = [...new Set(headerNavLinks.map((link) => link.getAttribute("href")))]
    .filter((href) => href?.startsWith("#"))
    .map((href) => document.querySelector(href))
    .filter(Boolean);

  if (observedSections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (visibleEntry?.target?.id) {
          setHeaderActive(`#${visibleEntry.target.id}`);
        }
      },
      {
        threshold: [0.2, 0.45, 0.7],
        rootMargin: "-30% 0px -55% 0px",
      }
    );

    observedSections.forEach((section) => observer.observe(section));
  }
</script>

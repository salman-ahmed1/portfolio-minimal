---
/*
  Mockup images are provided by shots.so
  Link: https://shots.so/
*/


import Image from "astro/components/Image.astro";
---

<section
  class="relative overflow-hidden bg-foreground w-full max-w-screen-2xl text-center flex flex-col justify-center items-center gap-10 px-4 py-24 sm:py-24 select-none"
>
  <h2
    class="z-10 w-full max-w-xl sm:text-center text-lg sm:text-2xl md:text-4xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground"
  >
    Every project is a new challenge to overcome.
  </h2>
  <p
    class="w-full max-w-xl bg-clip-text text-transparent bg-gradient-to-b from-background via-background to-muted-foreground sm:text-center text-normal sm:text-lg md:text-xl font-light tracking-tighter text-balance"
  >
    Design, Code, Learn, Repeat.
  </p>
  <div class="z-10 w-full grid grid-cols-1 md:grid-cols-5 grid-rows-6 gap-2">
    <article
      class=" relative bg-dark-card col-span-1 md:col-span-3 md:row-span-2 border border-dark-border rounded-[1rem] flex flex-col lg:flex-row lg:gap-3"
    >
      <div class="flex flex-col gap-2 w-full items-start p-4 tetx-left">
        <h3
          class="text-left sm:text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
        >
         Beverage Product visualization & animation
        </h3>
        <p
          class="w-full text-muted-foreground text-left text-sm sm:text-normal md:text-lg font-light tracking-tighter text-balance"
        >
          Realistic 100% environment friendly & 0% waste simulation animatinos.
        </p>
      </div>
      <div class="aspect-video hover:scale-125 transition-all duration-300 ease-in-out object-fill">
        <iframe class="border border-dark-border rounded-2xl h-full w-full"  src="https://www.youtube-nocookie.com/embed/dwy1i7O-N6o?si=QTIvlmu7wyaZApyG&amp;rel=0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </article>
    <article
      class="overflow-hidden group bg-dark-card col-span-1 md:col-span-2 md:row-span-2 md:col-start-4  border border-dark-border rounded-2xl p-4 flex flex-col flex-1 gap-2 justify-center items-center"
    >
      <div
        class="w-fit rounded-full bg-background px-4 py-2 flex justify-center items-center rotate-12 group-hover:rotate-0 border transition-all duration-300 ease-in-out"
      >
        <span
          class="text-normal sm:text-lg md:text-xl font-light tracking-tighter"
        >
          3D Animation
        </span>
      </div>
      <div
        class="w-fit rounded-full bg-background px-4 py-2 flex justify-center items-center -rotate-6 group-hover:rotate-0 border transition-all duration-300 ease-in-out"
      >
        <span
          class="text-normal sm:text-lg md:text-xl font-light tracking-tighter"
        >
         Design
        </span>
      </div>
      <div
        class="w-fit rounded-full bg-background px-4 py-2 flex justify-center items-center border"
      >
        <span
          class="text-normal sm:text-lg md:text-xl font-light tracking-tighter"
        >
           Web Development
        </span>
      </div>
      <div
        class="w-fit rounded-full bg-background px-4 py-2 flex justify-center items-center border rotate-12 group-hover:rotate-0 transition-all duration-300 ease-in-out"
      >
        <span
          class="text-normal sm:text-lg md:text-xl font-light tracking-tighter"
        >
         VFX
        </span>
      </div>
    </article>
    
    <article
      class=" bg-dark-card col-span-1 md:col-span-3 md:row-span-2 md:row-start-3 flex flex-col lg:flex-row lg:gap-3"
    >
      <div class="flex flex-col gap-2 w-full items-start p-4 tetx-left">
        <h3
          class="text-left sm:text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
        >
          Product visualization
        </h3>
        <p
          class="w-full text-muted-foreground text-left text-sm sm:text-normal md:text-lg font-light tracking-tighter text-balance"
        >
          Modelling, rendering & animations for your product.
        </p>
      </div>
      <div class="aspect-video hover:scale-125 transition-all duration-300 ease-in-out ">
        <iframe class="border border-dark-border rounded-2xl h-full w-full" width="560" height="315" src="https://www.youtube-nocookie.com/embed/S47IffiTPPg?si=7XEXdFQJvyiTwkz6&amp;rel=0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
      </div>
    </article>
    <article
      class=" bg-dark-card col-span-1 md:col-span-3 md:row-span-2 md:row-start-5 flex flex-col lg:flex-row lg:gap-3"
    >
      <div class="flex flex-col gap-2 w-full items-start p-4 tetx-left">
        <h3
          class="text-left sm:text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
        >
          Enviournment Rendering
        </h3>
        <p
          class="w-full text-muted-foreground text-left text-sm sm:text-normal md:text-lg font-light tracking-tighter text-balance"
        >
          Realistic environment rendering and simualtion in unreal engine 5.
        </p>
      </div>
      <div class="aspect-video  hover:scale-125 transition-all duration-300 ease-in-out">
        <iframe class="border border-dark-border rounded-2xl h-full w-full"  src="https://www.youtube.com/embed/HksQeYXrymc?si=8z_je_rlRTk_MfdD&amp;rel=0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> 
       
      </div>
    </article>
    <article
      class="overflow-hidden bg-dark-card col-span-1 md:col-span-2 md:row-span-2 md:col-start-4 md:row-start-5 border-dark-border rounded-2xl"
    >
      <div
        class="w-full h-full flex flex-col gap-5 justify-center items-center"
      >
        <h1
          class="sm:text-xl md:text-2xl font-medium tracking-tighter text-pretty bg-clip-text text-transparent bg-gradient-to-br from-background via-background to-secondary"
        >
          Lets work together
        </h1>
        <a
          href="https://www.linkedin.com/in/gonzalochale/"
          target="_blank"
          rel="noopener noreferrer"
          class="w-fit flex gap-2 justify-center items-center px-4 py-2 sm:text-lg font-medium text-background bg-primary rounded-full"
        >
          LinkedIn
          <svg
            width="256"
            height="256"
            xmlns="http://www.w3.org/2000/svg"
            preserveAspectRatio="xMidYMid"
            viewBox="0 0 256 256"
            class="size-5"
            ><path
              d="M218.123 218.127h-37.931v-59.403c0-14.165-.253-32.4-19.728-32.4-19.756 0-22.779 15.434-22.779 31.369v60.43h-37.93V95.967h36.413v16.694h.51a39.907 39.907 0 0 1 35.928-19.733c38.445 0 45.533 25.288 45.533 58.186l-.016 67.013ZM56.955 79.27c-12.157.002-22.014-9.852-22.016-22.009-.002-12.157 9.851-22.014 22.008-22.016 12.157-.003 22.014 9.851 22.016 22.008A22.013 22.013 0 0 1 56.955 79.27m18.966 138.858H37.95V95.967h37.97v122.16ZM237.033.018H18.89C8.58-.098.125 8.161-.001 18.471v219.053c.122 10.315 8.576 18.582 18.89 18.474h218.144c10.336.128 18.823-8.139 18.966-18.474V18.454c-.147-10.33-8.635-18.588-18.966-18.453"
              fill="currentColor"></path></svg
          >
        </a>
      </div>
    </article>
  </div>
  <div
    class="bg-white opacity-10 absolute size-80 top-[-160px] border blur-[150px] rounded-full"
  >
  </div>
</section>

<style>
  .group:hover .animate-vertical-slide {
    animation-play-state: paused;
  }
</style>

---
const featuredProject = {
  title: "Beverage Drink Visualization & Animation",
  description:
    "product-focused visuals making beverages feel premium and creating thrist.",
  embed:
    "https://www.youtube-nocookie.com/embed/dwy1i7O-N6o?controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0",
  label: "Project / Visualization",
};

const supportingProjects = [
  {
    title: "Product Visualization",
    description:
      "Detailed product renders and motion designed for sales pages, ads, and presentations that need immediate trust.",
    embed:
      "https://www.youtube-nocookie.com/embed/S47IffiTPPg?controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0",
    label: "Project / Design",
  },
    {
    title: "Short-Form Social Media Product Promotion",
    description:
      "A short vertical Game promotion designed for quick attention and call to action.",
    embed:
      "https://www.youtube-nocookie.com/embed/mERhTHQ8d9Q?controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0",
    label: "Shorts / Social/ Game promotion",
  },
  {
    title: "Digital Promotional Assets creation, 3D Product & Animation",
    description:
      "Optimized looping 3D Animation for websites and digital promotion.",
    embed:
      "https://www.youtube-nocookie.com/embed/9-GGL-Mbdc0?controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0",
    label: "Digital Assets",
  },
  {
    title: "3D Motion animation & Product Showcase",
    description:
      "Digital Promotioinal media for the business website's",
    embed:
      "https://www.youtube-nocookie.com/embed/3B9vWpwR2Xo?controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0",
    label: "Product Motion/ Web asset",
  },
  {
    title: "VFX Commercial promotion",
    description:
      "Realistic motion tracked vfx & Cinematic framing intended to make audiences stop and feel.",
    embed:
      "https://www.youtube-nocookie.com/embed/mhRPpzKFioc?controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0",
    label: "VFX/CGI Visuals",
  },

  {
    title: "Environment Rendering",
    description:
      "Cinematic real-time environments with Realistic lighting, depth, and composition for immersive storytelling.",
    embed:
      "https://www.youtube-nocookie.com/embed/HksQeYXrymc?controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0",
    label: "VFX / Unreal Engine",
  },
];

const websiteProjects = [
  {
    title: "Expense Tracker Web App",
    description:
      "A responsive finance tracking app built to help users record income and expenses, understand their balance at a glance, and manage everyday spending through a clean, simple interface.",
    image: "/assets/cash-journal.webp",
    href: "https://personal-journal01.netlify.app/",
    label: "Web App / Expense Tracker",
    stack: ["React", "Tailwind", "Local Storage"],
  },
  {
    title: "Simon Memory Game",
    description:
      "An interactive memory game built with JavaScript and jQuery, featuring pattern generation, user input handling, sound feedback, animations, and game-over state logic.",
    image: "/assets/simon-game-site.webp",
    href: "https://salman-ahmed1.github.io/Simon-game/",
    label: "Game / JavaScript",
    stack: ["JavaScript", "jQuery", "Game Logic"],
  },
  {
    title: "Responsive Dog Service Landing Page",
    description:
      "A Bootstrap landing page concept built to practice responsive layout, feature sections, testimonials, pricing cards, and clear calls-to-action for a simple service-based website.",
    image: "/assets/dog-service-landing-page.webp",
    href: "https://salman-ahmed1.github.io/My-Projects/Bootstrap-1/Dog%20Project/index.html",
    label: "Landing Page / Bootstrap",
    stack: ["HTML", "CSS", "Bootstrap"],
  },
];

const categoryCopy = {
  visuals: {
    kicker: "Selected Projects",
    title: 'Real work, <span class="dark-highlight">premium results</span>.',
    body: 'Here is how I help brands <span class="font-semibold text-white">stand out</span> in <span class="dark-highlight font-semibold">crowded markets</span>.',
  },
  websites: {
    kicker: "Website Projects",
    title: 'Focused websites, <span class="dark-highlight">clear presentation</span>.',
    body: 'Responsive web experiences built to help visitors <span class="font-semibold text-white">scan faster</span>, trust the offer, and take action.',
  },
};

const categoryCopyJson = JSON.stringify(categoryCopy);
---

<section class="dark-section relative w-full overflow-hidden px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-0 top-20 h-80 w-80 rounded-full bg-primary/10 blur-[150px]"></div>
    <div class="absolute right-0 top-1/3 h-96 w-96 rounded-full bg-secondary/10 blur-[180px]"></div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl">
    <div class="site-panel-shadow dark-panel rounded-3xl border px-5 py-6 backdrop-blur-sm sm:px-7 sm:py-7 lg:px-8">
      <div
        class="flex items-center justify-center gap-8 overflow-x-auto border-b border-white/10 pb-5"
        aria-label="Project categories"
        data-project-tabs
      >
        <button
          type="button"
          class="relative shrink-0 px-1 py-3 text-base font-semibold text-white transition-colors"
          aria-pressed="true"
          data-project-tab="visuals"
        >
          3D Visuals
          <span class="absolute inset-x-0 bottom-0 h-0.5 bg-primary opacity-100 transition-opacity" data-tab-line></span>
        </button>
        <span class="h-6 w-px shrink-0 bg-white/15" aria-hidden="true"></span>
        <button
          type="button"
          class="relative shrink-0 px-1 py-3 text-base font-semibold text-white/55 transition-colors hover:text-white"
          aria-pressed="false"
          data-project-tab="websites"
        >
          Websites
          <span class="absolute inset-x-0 bottom-0 h-0.5 bg-primary opacity-0 transition-opacity" data-tab-line></span>
        </button>
      </div>

      <div class="border-b border-white/10 py-6">
        <div class="max-w-2xl" data-reveal="soft">
          <p class="dark-kicker text-xs font-semibold uppercase tracking-[0.28em]" data-project-kicker>
            {categoryCopy.visuals.kicker}
          </p>
          <h2
            class="mt-4 text-2xl font-semibold tracking-normal text-white sm:text-3xl"
            data-project-title
            set:html={categoryCopy.visuals.title}
          ></h2>
          <p
            class="dark-body mt-3 text-base leading-7"
            data-project-body
            set:html={categoryCopy.visuals.body}
          ></p>
        </div>
      </div>

      <div class="mt-6 grid gap-5" data-project-panel="visuals">
        <article
          class="overflow-hidden rounded-3xl border border-white/10 bg-black sm:relative"
          data-reveal="scale"
        >
          <div class="relative aspect-video overflow-hidden bg-black lg:min-h-[34rem]">
            <iframe
              loading="lazy"
              class="mx-auto block h-full w-full"
              src={featuredProject.embed}
              title={featuredProject.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-48 bg-gradient-to-t from-black/95 via-black/45 to-transparent sm:block"></div>
          </div>
          <div class="border-t border-white/10 bg-black p-4 sm:absolute sm:bottom-6 sm:left-6 sm:right-6 sm:z-10 sm:border-none sm:bg-transparent sm:p-0">
            <p class="dark-kicker text-xs font-semibold uppercase tracking-[0.22em]">
              {featuredProject.label}
            </p>
            <h3 class="mt-3 max-w-[18ch] text-2xl font-semibold tracking-normal text-white sm:text-3xl">
              {featuredProject.title}
            </h3>
            <p class="dark-body mt-3 max-w-md text-sm leading-6 sm:text-base sm:leading-7">
              <span class="font-semibold text-white">Thirst quenching, Premium</span>
              {" "}
              
             {featuredProject.description}
            </p>
          </div>
        </article>

        <div class="grid gap-5 md:grid-cols-2">
          {
            supportingProjects.map((project, index) => (
              <article
                class:list={[
                  "min-w-0 overflow-hidden rounded-3xl border border-white/10 bg-black sm:relative",
                  index > 1 && "hidden-project hidden",
                ]}
                data-reveal="scale"
                style={`--reveal-delay:${index * 120}ms;`}
              >
                <div class="relative aspect-square min-h-64 overflow-hidden bg-black sm:min-h-80">
                  <iframe
                    loading="lazy"
                    class="mx-auto block h-full w-full"
                    src={project.embed}
                    title={project.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  ></iframe>
                  <div class="pointer-events-none absolute inset-x-0 bottom-0 hidden h-56 bg-gradient-to-t from-black/95 via-black/45 to-transparent sm:block"></div>
                </div>
                <div class="border-t border-white/10 bg-black p-4 sm:absolute sm:bottom-4 sm:left-4 sm:right-4 sm:z-10 sm:border-none sm:bg-transparent sm:p-0">
                  <p class="dark-kicker text-xs font-semibold uppercase tracking-[0.22em]">
                    {project.label}
                  </p>
                  <h3 class="mt-3 text-xl font-semibold tracking-normal text-white">
                    {project.title}
                  </h3>
                  <p class="dark-body mt-2 max-w-sm text-sm leading-6">
                    {project.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        <div class="flex justify-center pt-2">
          <button
            type="button"
            class="group inline-flex size-12 w-32 items-center justify-center rounded-full border border-white/20 bg-white/5 text-2xl leading-none text-white transition-colors duration-200 hover:bg-white/10"
            aria-label="Show more portfolio projects"
            aria-expanded="false"
            data-show-more-toggle
            data-reveal="soft"
            style="--reveal-delay:220ms;"
          >
            <span class="pr-1.5 text-sm font-light">See More</span>
            <span
              class="inline-block transition-transform duration-300 group-aria-expanded:rotate-180"
              aria-hidden="true"
            >
              <svg class="see-more-arrow inline-block size-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 4v12M6 12l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>

      <div class="mt-6 hidden" data-project-panel="websites">
        <div class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr] lg:items-stretch">
          {
            websiteProjects.map((project, index) => (
              <article
                class="group overflow-hidden rounded-3xl border border-white/10 bg-black"
                data-reveal="scale"
                style={`--reveal-delay:${index * 120}ms;`}
              >
                <a href={project.href} target="_blank" rel="noopener noreferrer" class="block">
                  <div class="relative aspect-video overflow-hidden bg-white/5">
                    <img
                      src={project.image}
                      alt={`${project.title} preview`}
                      class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-black/85 via-black/35 to-transparent"></div>
                  </div>
                  <div class="border-t border-white/10 p-5 sm:p-6">
                    <p class="dark-kicker text-xs font-semibold uppercase tracking-[0.22em]">
                      {project.label}
                    </p>
                    <h3 class="mt-3 text-2xl font-semibold tracking-normal text-white">
                      {project.title}
                    </h3>
                    <p class="dark-body mt-3 max-w-2xl text-sm leading-6 sm:text-base sm:leading-7">
                      {project.description}
                    </p>
                    <div class="mt-5 flex flex-wrap gap-2">
                      {
                        project.stack.map((item) => (
                          <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-white/75">
                            {item}
                          </span>
                        ))
                      }
                    </div>
                  </div>
                </a>
              </article>
            ))
          }

          <div
            class="dark-panel-soft flex flex-col justify-between rounded-3xl border p-6 sm:p-7"
            data-reveal="soft"
            style="--reveal-delay:140ms;"
          >
            <div>
              <p class="dark-kicker text-xs font-semibold uppercase tracking-[0.22em]">
                Website Delivery
              </p>
              <h3 class="mt-4 text-2xl font-semibold tracking-normal text-white">
                Built for clear presentation, fast loading, and strong first impressions.
              </h3>
              <p class="dark-body mt-4 text-base leading-7">
                This category is separated from the 3D work so visitors can judge website execution without switching context between videos and web previews.
              </p>
            </div>
            <a
              href="#contact"
              class="mt-8 inline-flex min-h-12 items-center justify-center rounded-2xl border border-white/12 bg-white/6 px-5 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-white/10"
            >
              Discuss a Website Project
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .see-more-arrow {
    animation: see-more-nudge 2.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes see-more-nudge {
    0%{
      transform: translateY(-1px);
    }

    
    50% {
      transform: translateY(1.5px);
    }
      100% {
        transform: translateY(-1px);
      }
  }

  @media (prefers-reduced-motion: reduce) {
    .see-more-arrow {
      animation: none;
    }
  }
</style>

<script is:inline type="application/json" id="project-category-copy" set:html={categoryCopyJson}></script>

<script is:inline>
  const categoryCopy = JSON.parse(document.getElementById("project-category-copy")?.textContent || "{}");
  const toggle = document.querySelector("[data-show-more-toggle]");
  const hiddenProjects = document.querySelectorAll(".hidden-project");
  const projectTabs = document.querySelectorAll("[data-project-tab]");
  const projectPanels = document.querySelectorAll("[data-project-panel]");
  const projectKicker = document.querySelector("[data-project-kicker]");
  const projectTitle = document.querySelector("[data-project-title]");
  const projectBody = document.querySelector("[data-project-body]");

  projectTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      if (!(tab instanceof HTMLButtonElement)) return;

      const activeCategory = tab.dataset.projectTab;
      const copy = categoryCopy[activeCategory];

      if (!copy) return;

      if (projectKicker) projectKicker.textContent = copy.kicker;
      if (projectTitle) projectTitle.innerHTML = copy.title;
      if (projectBody) projectBody.innerHTML = copy.body;

      projectTabs.forEach((projectTab) => {
        if (!(projectTab instanceof HTMLButtonElement)) return;

        const isActive = projectTab.dataset.projectTab === activeCategory;
        const line = projectTab.querySelector("[data-tab-line]");

        projectTab.setAttribute("aria-pressed", String(isActive));
        projectTab.classList.toggle("text-white", isActive);
        projectTab.classList.toggle("text-white/55", !isActive);
        line?.classList.toggle("opacity-100", isActive);
        line?.classList.toggle("opacity-0", !isActive);
      });

      projectPanels.forEach((panel) => {
        if (!(panel instanceof HTMLElement)) return;

        const isActive = panel.dataset.projectPanel === activeCategory;
        panel.classList.toggle("hidden", !isActive);

        if (isActive) {
          window.__siteReveal?.revealScope?.(panel);
        }
      });
    });
  });

  if (toggle && hiddenProjects.length) {
    toggle.addEventListener("click", () => {
      const opening = hiddenProjects[0].classList.contains("hidden");
      const revealApi = window.__siteReveal;

      hiddenProjects.forEach((project, index) => {
        if (!(project instanceof HTMLElement)) return;

        if (opening) {
          project.classList.add("opacity-0");
          project.classList.remove("hidden", "is-visible");
          project.style.setProperty("--reveal-delay", `${index * 120}ms`);

          requestAnimationFrame(() => {
            revealApi?.markVisible?.(project);
            project.classList.remove("opacity-0");
          });
          return;
        }

        revealApi?.markHidden?.(project);
        project.classList.add("hidden");
      });
      toggle.setAttribute("aria-expanded", String(opening));
      toggle.setAttribute(
        "aria-label",
        opening ? "Show fewer portfolio projects" : "Show more portfolio projects"
      );
    });
  }
</script>

---
const heroVideo =
  "https://www.youtube-nocookie.com/embed/videoseries?controls=0&list=PLVCSgmpWFEbu-mL9JXRDLRHwhhYfhwOAK&rel=0&mute=1&autoplay=1&loop=1&playlist=PLVCSgmpWFEbu-mL9JXRDLRHwhhYfhwOAK";
---

<section
  id="hero"
  class="relative isolate w-full overflow-hidden px-4 pb-20 pt-0 sm:px-6 sm:pb-24 sm:pt-0 lg:px-8 lg:pb-28"
>
  <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden rounded-b-[2rem]">
    <div class="hero-video absolute inset-0 ">
      <iframe
        class="hero-video__frame"
        src={heroVideo}
        title="Salman Ahmed showreel background"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(130,110,255,0.16),transparent_66%),linear-gradient(180deg,rgba(6,6,10,0.2),rgba(6,6,10,0.88)_98%,rgba(6,6,10,0.96)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-[#050507]"></div>
  </div>

  <div class="pointer-events-none absolute left-0 top-1/2 -z-10 size-72 -translate-y-1/2 rounded-full bg-primary/12 blur-[140px]"></div>
  <div class="pointer-events-none absolute bottom-10 right-0 -z-10 size-80 rounded-full bg-secondary/12 blur-[160px]"></div>

  <div class="mx-auto flex min-h-[100dvh] w-full max-w-5xl items-center justify-center pt-24 sm:pt-28 lg:pt-32">
    <div class="flex max-w-3xl flex-col items-center text-center text-white">
      <span
        class="hero-copy dark-kicker opacity-0 text-xs font-semibold uppercase tracking-[0.42em]"
      >
        Visionary 3D Artist
      </span>
      <h1
        class="hero-copy hero-copy-delay-1 mt-6 max-w-[13ch] text-balance text-[2.7rem] font-semibold leading-[1.04] tracking-[-0.045em] text-white opacity-0 sm:text-[3.7rem] md:text-[4.6rem] lg:text-[5rem]"
      >
        Helping You Visualize Your
        <span class="bg-gradient-to-r from-[#9f8bff] via-[#bbaeff] to-[#8db0ff] bg-clip-text text-transparent">
          Ideas
        </span>
        With
        <span class="bg-gradient-to-r from-[#a392ff] via-[#c6bfff] to-[#98a9ff] bg-clip-text text-transparent">
          Design
        </span>
      </h1>
      <p
        class="hero-copy hero-copy-delay-2 dark-body mt-8 max-w-xl text-balance text-base leading-7 opacity-0 sm:text-lg sm:leading-8"
      >
        High-impact 3D visuals and digital solutions without unnecessary overhead.
        Elevate your brand with cinematic product storytelling.
      </p>

      <div
        class="hero-copy hero-copy-delay-3 mt-10 flex flex-col items-center gap-4 opacity-0 sm:flex-row"
      >
        <a
          href="https://www.linkedin.com/in/salman-ahmed-designer/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-w-52 items-center justify-center rounded-2xl bg-gradient-to-r from-primary to-[#4d7cff] px-7 py-4 text-sm font-semibold text-white shadow-[0_18px_40px_rgba(99,102,241,0.35)] transition-transform duration-200 hover:-translate-y-0.5"
        >
          Get Your Free Quote
        </a>
        <a
          href="https://www.youtube.com/@salmanahmed3d"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-w-52 items-center justify-center rounded-2xl border border-white/12 bg-white/6 px-7 py-4 text-sm font-semibold text-white transition-colors duration-200 hover:bg-white/10"
        >
          View Showreel
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes heroIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-copy {
    animation: heroIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-copy-delay-1 {
    animation-delay: 0.12s;
  }

  .hero-copy-delay-2 {
    animation-delay: 0.24s;
  }

  .hero-copy-delay-3 {
    animation-delay: 0.36s;
  }

  .hero-video__frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 177.77777778vh;
    min-width: 100%;
    min-height: 56.25vw;
    transform: translate(-50%, -50%);
    border: 0;
  }

  @media (max-aspect-ratio: 16/9) {
    .hero-video__frame {
      width: 100vw;
      height: 56.25vw;
    }
  }
</style>

---
const heroVideo =
  "https://www.youtube-nocookie.com/embed/videoseries?controls=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3&disablekb=1&fs=0&cc_load_policy=0&mute=1&autoplay=1&loop=1&list=PLVCSgmpWFEbu-mL9JXRDLRHwhhYfhwOAK&playlist=PLVCSgmpWFEbu-mL9JXRDLRHwhhYfhwOAK";
---

<section
  id="hero"
  class="relative isolate w-full overflow-hidden px-4 pb-20 pt-0 sm:px-6 sm:pb-24 sm:pt-0 lg:px-8 lg:pb-28"
>
  <div class="pointer-events-none absolute inset-0 -z-20 overflow-hidden rounded-b-4xl">
    <div class="hero-video absolute inset-0 ">
      <iframe
        class="hero-video__frame"
        src={heroVideo}
        title="Salman Ahmed showreel background"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
    </div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(130,110,255,0.16),transparent_66%),linear-gradient(180deg,rgba(6,6,10,0.2),rgba(6,6,10,0.88)_98%,rgba(6,6,10,0.96)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-dark-surface"></div>
  </div>

  <div class="pointer-events-none absolute left-0 top-1/2 -z-10 size-72 -translate-y-1/2 rounded-full bg-primary/12 blur-[140px]"></div>
  <div class="pointer-events-none absolute bottom-10 right-0 -z-10 size-80 rounded-full bg-secondary/12 blur-[160px]"></div>

  <div class="mx-auto flex min-h-dvh w-full max-w-5xl items-center justify-center pt-24 sm:pt-28 lg:pt-32">
    <div class="flex max-w-3xl flex-col items-center text-center text-white">
      <span
        class="hero-copy dark-kicker opacity-0 text-xs font-semibold uppercase tracking-[0.42em]"
      >
        3D Product Visualization & Animation
      </span>
      <h1
        class="hero-copy hero-copy-delay-1 mt-6 text-balance text-5xl font-semibold leading-tight tracking-tighter text-white opacity-0 sm:text-6xl md:text-7xl lg:text-8xl"
      >
        Premium Visuals
        for brands to <span class="bg-gradient-to-r from-[#a392ff] via-[#c6bfff] to-[#98a9ff] bg-clip-text text-transparent"> stand out.</span>
      </h1>
      <p
        class="hero-copy hero-copy-delay-2 dark-body mt-8 flex w-full max-w-xl items-center justify-center gap-x-1 text-center font-light text-base leading-7 opacity-0 sm:text-lg sm:leading-8"
        aria-label="Ideas into visuals, websites, and digital assets"
      >
        <span class="shrink-0 font-light text-white" aria-hidden="true">Ideas into</span>
        <span class="dark-highlight inline-flex shrink-0 justify-start text-left font-normal" aria-hidden="true">
          <span data-hero-typewriter>visuals</span><span class="hero-type-cursor"></span>
        </span>
      </p>

      <div
        class="hero-copy hero-copy-delay-3 mt-10 flex flex-col items-center gap-4 opacity-0 sm:flex-row"
      >
        <a
          href="https://www.linkedin.com/in/salman-ahmed-designer/"
          target="_blank"
          rel="noopener noreferrer"
          class="site-cta-shadow inline-flex min-w-52 items-center justify-center rounded-2xl bg-gradient-to-r from-primary to-[#4d7cff] px-7 py-4 text-sm font-semibold text-white transition-transform duration-200 hover:-translate-y-0.5"
        >
          Get a Free Project Estimate
        </a>
        <a
          href="https://www.youtube.com/@salmanahmed3d"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-w-52 items-center justify-center rounded-2xl border border-white/12 bg-white/6 px-7 py-4 text-sm font-semibold text-white transition-colors duration-200 hover:bg-white/10"
        >
          Watch Showreel
        </a>
      </div>
      <p class="hero-copy hero-copy-delay-3 dark-muted mt-5 text-sm opacity-0">
        Clear communication &middot; Fast iteration &middot; Business-ready delivery
      </p>
    </div>
  </div>
</section>

<style>
  @keyframes heroIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-copy {
    animation: heroIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-copy-delay-1 {
    animation-delay: 0.12s;
  }

  .hero-copy-delay-2 {
    animation-delay: 0.24s;
  }

  .hero-copy-delay-3 {
    animation-delay: 0.36s;
  }

  .hero-type-cursor {
    margin-left: 0.12em;
    width: 1px;
    background: currentColor;
    animation: heroCursorBlink 0.9s steps(2, jump-none) infinite;
  }

  @keyframes heroCursorBlink {
    0%,
    45% {
      opacity: 1;
    }

    46%,
    100% {
      opacity: 0;
    }
  }

  .hero-video__frame {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 177.77777778vh;
    min-width: 100%;
    min-height: 56.25vw;
    transform: translate(-50%, -50%);
    border: 0;
  }

  @media (max-aspect-ratio: 16/9) {
    .hero-video__frame {
      width: 100vw;
      height: 56.25vw;
    }
  }

</style>

<script>
  const typewriter = document.querySelector("[data-hero-typewriter]");
  const words = ["visuals", "websites", "digital assets"];

  if (typewriter) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (prefersReducedMotion) {
      typewriter.textContent = words[0];
    } else {
      let wordIndex = 0;
      let letterIndex = words[0].length;
      let isDeleting = true;

      const typeNext = () => {
        const currentWord = words[wordIndex];
        typewriter.textContent = currentWord.slice(0, letterIndex);

        if (!isDeleting && letterIndex === currentWord.length) {
          isDeleting = true;
          window.setTimeout(typeNext, 1200);
          return;
        }

        if (isDeleting && letterIndex === 0) {
          isDeleting = false;
          wordIndex = (wordIndex + 1) % words.length;
          window.setTimeout(typeNext, 180);
          return;
        }

        letterIndex += isDeleting ? -1 : 1;
        window.setTimeout(typeNext, isDeleting ? 42 : 72);
      };

      window.setTimeout(typeNext, 900);
    }
  }
</script>

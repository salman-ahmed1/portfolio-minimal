---

<footer class="dark-section relative w-full overflow-hidden px-0 sm:pb-10 pt-8 sm:px-6 lg:px-8">
  <div
    class="dark-panel mx-auto w-full max-w-7xl sm:rounded-3xl border px-6 backdrop-blur-sm sm:px-8 py-10"
    data-reveal="scale"
  >
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl" data-reveal="soft">
        <span class="dark-kicker text-xs font-semibold uppercase tracking-[0.38em]">
          Salman Ahmed
        </span>
        <h3 class="theme-strong mt-4 text-3xl font-semibold tracking-tighter sm:text-4xl">
          3D visuals, motion, and
          <span class="dark-highlight">{" "}digital design{" "}</span>
          built to present products clearly.
        </h3>
        <p class="dark-body mt-4 max-w-xl text-base leading-7 sm:text-lg">
          Available for
          <span class="theme-strong font-semibold">product visualization</span>,
          animation,
          <span class="dark-highlight font-semibold"> design</span>, and frontend work with a
          <span class="dark-highlight font-semibold">{" "}clean, collaborative process{" "}</span>
          from concept to delivery.
        </p>
      </div>

      <div class="flex flex-col gap-4 lg:items-end" data-reveal="soft" style="--reveal-delay:140ms;">
        <p class="dark-muted text-sm font-semibold uppercase tracking-[0.18em]">
          Connect
        </p>
        <div class="flex flex-wrap gap-3">
          {
            socials.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="theme-control inline-flex min-h-9 items-center justify-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold"
              >
                <svg class="size-3.5 shrink-0 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d={social.icon}></path>
                </svg>
                {social.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div
      class="theme-border mt-10 flex flex-col gap-4 border-t pt-6 sm:flex-row sm:items-center sm:justify-between"
      data-reveal="soft"
      style="--reveal-delay:220ms;"
    >
      <p class="dark-body text-sm leading-6">
        <span class="theme-strong font-semibold">Salman Ahmed</span>, 3D Artist,
        Product Modeller, Animator, Graphics Designer, and UI/UX Designer.
      </p>
      <p class="dark-muted text-sm leading-6">
        Built for clear presentation and readable content.
        <a
          href="/web-development"
          class="theme-strong ml-1 font-semibold underline decoration-primary/50 underline-offset-4 hover:text-primary"
        >
          Web Development
        </a>
      </p>
    </div>
  </div>
</footer>

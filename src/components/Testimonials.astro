---
const testimonials = [
  {
    name: "Anthony F.",
    title: "iOS Game Developer",
    text: "Understood my vision, communicated clearly, and delivered strong work on time.",
    src: "/assets/3d-animation-review-salman-ahmed.webp",
    alt: "3D animation review",
    tag: "3D Animation",
  },
  {
    name: "Dave",
    title: "Product Designer",
    text: "Very talented, cordial, and a pleasure to work with throughout the project.",
    src: "/assets/3d-render-review-salman-ahmed.webp",
    alt: "3D render review",
    tag: "3D Render",
  },
  {
    name: "Anthony Freymond",
    title: "iOS Game Developer",
    text: "Did an amazing job for the Shift2 advert and translated the game concept well.",
    src: "/assets/3d-animator-review-salman-ahmed.webp",
    alt: "3D animator review",
    tag: "Product Visuals",
  },
];
---

<section class="dark-section relative w-full overflow-hidden px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 rounded-full bg-primary/12 blur-[140px]"></div>
    <div class="absolute bottom-10 right-0 h-80 w-80 rounded-full bg-secondary/10 blur-[160px]"></div>
  </div>

  <div class="relative mx-auto flex w-full max-w-7xl flex-col gap-12">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <span class="dark-kicker text-xs font-semibold uppercase tracking-[0.38em]">
        Client Stories
      </span>
      <h2 class="mt-5 max-w-[13ch] text-balance text-4xl font-semibold leading-tight tracking-[-0.04em] text-white sm:text-5xl">
        Trusted by clients who needed
        <span class="dark-highlight">better visuals</span>
        fast.
      </h2>
      <p class="dark-body mt-5 max-w-2xl text-balance text-base leading-7 sm:text-lg">
        Full
        <span class="font-semibold text-white">review screenshots</span>,
        cleaner presentation, and a
        <span class="dark-highlight font-semibold">clearer proof of trust</span>
        for faster scanning.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 text-center sm:flex-row">
        <a
          href="https://www.upwork.com/freelancers/salmanahmed381"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center rounded-full border border-white/12 bg-white/6 px-5 py-3 text-sm font-semibold text-white transition-colors duration-200 hover:bg-white/10"
        >
          View Upwork Reviews
        </a>
        <span class="dark-body text-sm font-medium">
          <span class="font-semibold text-white">5-star ratings</span>
          and
          <span class="dark-highlight font-semibold">100% client satisfaction</span>
        </span>
      </div>
    </div>

    <div class="relative overflow-hidden">
      <div class="testimonial-track flex gap-6">
        {
          testimonials.concat(testimonials).map((testimonial) => (
            <article class="testimonial-card dark-panel flex w-[min(88vw,26rem)] shrink-0 flex-col overflow-hidden rounded-[1.75rem] border shadow-[0_24px_80px_rgba(0,0,0,0.28)] backdrop-blur-sm">
              <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
                <div>
                  <p class="text-base font-semibold text-white">{testimonial.name}</p>
                  <p class="dark-muted mt-1 text-xs uppercase tracking-[0.18em]">
                    {testimonial.title}
                  </p>
                </div>
                <span class="dark-panel-soft rounded-full border px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.22em] backdrop-blur-md">
                  {testimonial.tag}
                </span>
              </div>

              <div class="dark-panel-soft p-4">
                <img
                  src={testimonial.src}
                  alt={testimonial.alt}
                  class="h-auto w-full rounded-2xl border border-white/8 object-contain"
                />
              </div>

              <div class="flex flex-col gap-4 px-5 pb-5 pt-2">
                <div class="flex gap-1 text-[#f6c56b]">
                  {[...Array(5)].map(() => (
                    <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z" />
                    </svg>
                  ))}
                </div>
                <p class="dark-body text-base leading-7">
                  "{testimonial.text}"
                </p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-[#050507] to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-[#050507] to-transparent"></div>
    </div>
  </div>
</section>

<style>
  @keyframes testimonialMarquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-50% - 0.75rem));
    }
  }

  .testimonial-track {
    width: max-content;
    animation: testimonialMarquee 34s linear infinite;
  }

  .testimonial-track:hover {
    animation-play-state: paused;
  }

  @media (max-width: 767px) {
    .testimonial-track {
      animation-duration: 42s;
    }

    .testimonial-card {
      width: min(90vw, 22rem);
    }
  }
</style>

---
import Image from "astro/components/Image.astro";

/*
    Logos were provided by "svgl" free and open source icons library.
    Link: https://svgl.app/
*/
const logos = [
  { src: "/logos/blender.svg", alt: "Blender Logo" },
  { src: "/logos/unreal.svg", alt: "Unreal Logo" },
  { src: "/logos/davinci-resolve.svg", alt: "Davinci Resolve Logo" },
  { src: "/logos/figma.svg", alt: "Figma Logo" },
  { src: "/logos/adobe.svg", alt: "Adobe Logo" },
  { src: "/logos/astro.svg", alt: "AstroJS Logo" },
  { src: "/logos/react.svg", alt: "ReactJS Logo" },
  { src: "/logos/tailwindcss.svg", alt: "TailwindCSS Logo" },
  { src: "/logos/openai_dark.svg", alt: "OpenAI Logo" },
];
---

<section class="dark-section relative w-full overflow-hidden py-16 sm:py-20 2xl:py-28">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-12 top-10 h-48 w-48 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute right-12 bottom-0 h-56 w-56 rounded-full bg-accent/5 blur-3xl"></div>
  </div>

  <div class="relative w-full">
    <div class="theme-subtle-surface theme-border w-full border-y px-5 py-8 sm:px-8 sm:py-10">
      <div class="mx-auto max-w-3xl text-center 2xl:max-w-4xl" data-reveal="soft">
        <p class="dark-kicker text-xs font-semibold uppercase tracking-tight">
          Tools and Workflow
        </p>
        <h2 class="theme-strong mt-4 text-2xl font-semibold tracking-tighter sm:text-3xl lg:text-4xl 2xl:text-5xl">
          The tech behind the
          <span class="dark-highlight"> visuals</span>.
        </h2>
        <p class="dark-body mx-auto mt-3 max-w-2xl text-sm leading-7 sm:text-base">
          A hand-picked production stack optimized for
          <span class="theme-strong font-medium"> jaw-dropping quality</span>,
          <span class="theme-strong font-medium"> fast turnaround times</span>, and
          <span class="theme-strong font-medium"> seamless web integration</span>.
        </p>
      </div>

      <div
        class="logo-marquee mx-auto mt-8 max-w-6xl overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_12%,black_88%,transparent)] 2xl:mt-12 2xl:max-w-screen-2xl"
        data-reveal="soft"
      >
        <div class="logo-marquee__track flex w-max gap-16">
          {
            logos.concat(logos).map((logo) => (
              <div class="dark-panel-soft flex size-20 items-center justify-center rounded-2xl border">
                <Image
                  src={logo.src}
                  alt={logo.alt}
                  width={38}
                  height={38}
                  loading="eager"
                  class="theme-logo h-9 w-9 object-contain"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes logoMarqueeOnce {
    to {
      transform: translateX(calc(-50% - 2rem));
    }
  }

  .logo-marquee__track {
    transform: translateX(0);
  }

  .logo-marquee.is-visible .logo-marquee__track {
    animation: logoMarqueeOnce 26s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee.is-visible .logo-marquee__track {
      animation: none;
    }
  }
</style>

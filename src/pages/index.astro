---
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import Stack from "@/components/Stack.astro";
import Projects from "@/components/Projects.astro";
import Testimonials from "@/components/Testimonials.astro";
import About from "@/components/About.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Struggling with flat visuals? Get stunning 3d animation, modelling, & product visualization that captivates customers & boosts sales.">
  <main
    class="relative w-full flex flex-col justify-start items-center pattern"
  >
    <Header />
    <Hero />
    <Stack />
    <Projects />
    <Testimonials/>
    <About />
    <Footer />
  </main>
</Layout>

<style>
  .pattern {
    background-color: #ffffff00;
    background-image: radial-gradient(circle at top center, #f5fdffa6 70px, #ffffff4d), repeating-radial-gradient(circle at top center, #ffffff00, #ffffff3b, 200px, #00000000 0, #eaeaea00 201px)
    background-blend-mode: multiply;
    
  }
</style>

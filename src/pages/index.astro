---
import Nav from "@/components/Nav.astro";
import Hero from "@/components/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import Stack from "@/components/Stack.astro";
import Projects from "@/components/Projects.astro";
import Testimonials from "@/components/Testimonials.astro";
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Struggling with flat visuals? Get stunning 3d animation, modelling, & product visualization that captivates customers & boosts sales.">
  <main class="relative flex w-full flex-col items-center justify-start bg-background">
    <section class="top-fold dark-section w-full">
      <Nav />
      <Hero />
    </section>
    <div id="process" class="w-full">
      <Stack />
    </div>
    <div id="portfolio" class="w-full">
      <Projects />
    </div>
    <div id="stories" class="w-full">
      <Testimonials />
    </div>
    <div id="contact" class="w-full">
      <Contact />
      <Footer />
    </div>
  </main>
</Layout>

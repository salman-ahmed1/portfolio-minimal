---
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Layout from "@/layouts/Layout.astro";
import Stack from "@/components/Stack.astro";
import Projects from "@/components/Projects.astro";
import Testimonials from "@/components/Testimonials.astro";
import About from "@/components/About.astro";
import Footer from "@/components/Footer.astro";
---

<Layout title="Struggling with flat visuals? Get stunning 3d animation, modelling, & product visualization that captivates customers & boosts sales.">
  <main class="relative flex w-full flex-col items-center justify-start bg-background">
    <section class="w-full bg-[#050507]">
      <Header />
      <Hero />
    </section>
    <div id="process" class="w-full">
      <Stack />
    </div>
    <div id="portfolio" class="w-full">
      <Projects />
    </div>
    <div id="stories" class="w-full">
      <Testimonials />
    </div>
    <div id="contact" class="w-full">
      <About />
      <Footer />
    </div>
  </main>
</Layout>

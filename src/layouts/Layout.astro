---
import { SEO } from "astro-seo";
import SpeedInsights from "@vercel/speed-insights/astro"
import Analytics from '@vercel/analytics/astro'
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const GA_ID = "G-LLTE84V97Q";
---

<!doctype html>
<html lang="en">
<head>
  

<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>

<script is:inline define:vars={{ GA_ID }}>
  // @ts-nocheck
  window.dataLayer = window.dataLayer || [];

  function gtag(...args) {
    window.dataLayer.push(args);
  }

  gtag('js', new Date());
  gtag('config', GA_ID);
</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">
    <SEO
      title="Salman Ahmed | Expert 3D Animation & Product Visualization"
      description="Salman ahmed a 3d artist, animator & product visualizer | Graphics & UI/UX Designer | Forntend Developer | Digital Marketer helping you bringing your visions to life"
      openGraph={{
        basic: {
          title: "Salman Ahmed | Expert 3D Animation & Product Visualization That you can trust",
          type: "website",
          image:
            "https://raw.githubusercontent.com/gonzalochale/litefolio/v2/public/assets/preview.png",
        },
      }}
     
    />
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Struggling with flat visuals? Get stunning 3d animation, modelling, & product visualization that captivates customers & boosts sales."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    
  </head>
  
  <body
    class="relative flex flex-col w-full min-h-dvh justify-center items-center bg-background"
  >
  
    <slot />
    <SpeedInsights />
    <Analytics />
  </body>
</html>

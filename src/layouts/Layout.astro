---
import { SEO } from "astro-seo";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  openGraphTitle?: string;
  openGraphDescription?: string;
  openGraphImage?: string;
  openGraphImageAlt?: string;
}

const {
  title,
  description,
  canonical,
  openGraphTitle,
  openGraphDescription,
  openGraphImage,
  openGraphImageAlt,
} = Astro.props;

const hasCustomMetadata = Boolean(description || canonical || openGraphTitle || openGraphDescription);
const defaultSeoTitle = "Salman Ahmed | Expert 3D Animation & Product Visualization";
const defaultSeoDescription =
  "Salman ahmed a 3d artist, animator & product visualizer | Graphics & UI/UX Designer | Forntend Developer | Digital Marketer helping you bringing your visions to life";
const resolvedOpenGraphTitle = openGraphTitle ?? title;
const resolvedOpenGraphDescription = openGraphDescription ?? description;
const resolvedOpenGraphImage = openGraphImage ?? "/Sal3dVisuals.svg";
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("theme");
          document.documentElement.classList.toggle("dark", theme === "dark");
        } catch {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LLTE84V97Q"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-LLTE84V97Q");
    </script>
    <SEO
      title={hasCustomMetadata ? title : defaultSeoTitle}
      description={description ?? defaultSeoDescription}
      canonical={canonical}
      openGraph={{
        basic: {
          title: hasCustomMetadata
            ? resolvedOpenGraphTitle
            : "Salman Ahmed | Expert 3D Animation & Product Visualization That you can trust",
          type: "website",
          image: resolvedOpenGraphImage,
          url: canonical,
        },
        optional: hasCustomMetadata
          ? {
              description: resolvedOpenGraphDescription,
              siteName: "Salman Ahmed Portfolio",
            }
          : undefined,
        image: hasCustomMetadata
          ? {
              url: resolvedOpenGraphImage,
              alt: openGraphImageAlt ?? "Salman Ahmed portfolio",
            }
          : undefined,
      }}
      twitter={hasCustomMetadata
        ? {
            card: "summary_large_image",
            creator: "@Sal3DVisuals",
            title: resolvedOpenGraphTitle,
            description: resolvedOpenGraphDescription,
            image: resolvedOpenGraphImage,
            imageAlt: openGraphImageAlt ?? "Salman Ahmed portfolio",
          }
        : undefined}
    />
    <meta charset="UTF-8" />
    {
      !hasCustomMetadata && (
        <meta
          name="description"
          content="Struggling with flat visuals? Get stunning 3d animation, modelling, & product visualization that captivates customers & boosts sales."
        />
      )
    }
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/Sal3dVisuals.svg" />
    <meta name="generator" content={Astro.generator} />
    {!hasCustomMetadata && <title>{title}</title>}
  </head>

  <body
    class="relative flex min-h-dvh w-full flex-col items-center justify-center bg-background"
  >
    <slot />
    <SpeedInsights />
    <Analytics />
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const revealSelector = "[data-reveal]";

        const markVisible = (element) => {
          if (!(element instanceof HTMLElement)) return;
          element.classList.add("is-visible");
        };

        const markHidden = (element) => {
          if (!(element instanceof HTMLElement)) return;
          element.classList.remove("is-visible");
        };

        const revealScope = (scope) => {
          if (!(scope instanceof Element)) return;
          scope.querySelectorAll(revealSelector).forEach(markVisible);
        };

        window.__siteReveal = { markVisible, markHidden, revealScope };

        if (reduceMotion) {
          document.querySelectorAll(revealSelector).forEach(markVisible);
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!(entry.target instanceof HTMLElement)) return;

              if (entry.isIntersecting) {
                markVisible(entry.target);
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -5% 0px",
          }
        );

        document.querySelectorAll(revealSelector).forEach((element) => {
          observer.observe(element);
        });
      })();
    </script>
  </body>
</html>

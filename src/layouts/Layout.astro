---
import { SEO } from "astro-seo";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import "@/styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-LLTE84V97Q"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-LLTE84V97Q");
    </script>
    <SEO
      title="Salman Ahmed | Expert 3D Animation & Product Visualization"
      description="Salman ahmed a 3d artist, animator & product visualizer | Graphics & UI/UX Designer | Forntend Developer | Digital Marketer helping you bringing your visions to life"
      openGraph={{
        basic: {
          title: "Salman Ahmed | Expert 3D Animation & Product Visualization That you can trust",
          type: "website",
          image:
            "https://raw.githubusercontent.com/gonzalochale/litefolio/v2/public/assets/preview.png",
        },
      }}
    />
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Struggling with flat visuals? Get stunning 3d animation, modelling, & product visualization that captivates customers & boosts sales."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>

  <body
    class="relative flex min-h-dvh w-full flex-col items-center justify-center bg-background"
  >
    <slot />
    <SpeedInsights />
    <Analytics />
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const revealSelector = "[data-reveal]";

        const markVisible = (element) => {
          if (!(element instanceof HTMLElement)) return;
          element.classList.add("is-visible");
        };

        const markHidden = (element) => {
          if (!(element instanceof HTMLElement)) return;
          element.classList.remove("is-visible");
        };

        const revealScope = (scope) => {
          if (!(scope instanceof Element)) return;
          scope.querySelectorAll(revealSelector).forEach(markVisible);
        };

        window.__siteReveal = { markVisible, markHidden, revealScope };

        if (reduceMotion) {
          document.querySelectorAll(revealSelector).forEach(markVisible);
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!(entry.target instanceof HTMLElement)) return;

              if (entry.isIntersecting) {
                markVisible(entry.target);
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -5% 0px",
          }
        );

        document.querySelectorAll(revealSelector).forEach((element) => {
          observer.observe(element);
        });
      })();
    </script>
  </body>
</html>
